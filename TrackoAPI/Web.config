<configuration>
	<configSections>
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
		<section name="unity" type="Microsoft.Practices.Unity.Configuration.UnityConfigurationSection,Microsoft.Practices.Unity.Configuration" />
	</configSections>
	<appSettings>
		<add key="AllowMigration" value="true" />
		<add key="AllowDataLossMigration" value="true" />
		<add key="dbbackuppath" value="C:\GOFLEETClient Db Backup" />
		<add key="GPSSyncIntervalInMinutes" value="30" />
		<add key="FileUploadFolderName" value="~/Files" />
		<add key="HostedOnPremise" value="false" />
		<add key="GatewayUrl" value="http://localhost/Tracko_API/" />
		<add key="GofleetGISUrl" value="http://localhost/Tracko_API/" />
		<add key="WebAppUrl" value="http://localhost/Tracko_API/" />

		<!--africa ke liye 2 database hai aur india ke liye 1 hai-->
		<add key="APICountryRegion" value="africa" />
		<add key="RedisDatabase" value="2" />

		<add key="CountryTimeZone" value="W. Central Africa Standard Time" />
		
		<add key="EFTracingFlag" value="true" />
		<add key="RedisCacheFlag" value="true" />
		<add key="HanfireStorage" value="redis" />
		<!--redis/msssql/sqlite-->
		<add key="RedisNetworkAddress" value="127.0.0.1" />
		<add key="RedisPassword" value="YUib__(*)@#_($&lt;l__@#" lockItem="false" />
		
		<add key="RedisPort" value="6379" />
		
		
		<add key="HangfireQueues" value="fifo_0fc48162619d4fd39805caefc62785af" />
		<!-- erp.gofleet@gmail.com-->
		<add key="SMTPSettings" value="eyJTTVRQQWRkcmVzcyI6InNtdHAuZ21haWwuY29tIiwiVXNlck5hbWUiOiJlcnAuZ29mbGVldEBnbWFpbC5jb20iLCJQYXNzd29yZCI6Imxja2IgY3VoaCBtcnBzIGZ0d28iLCJQb3J0Ijo1ODcsIkZyb21FbWFpbCI6Im5vLXJlcGx5QGdvZmxlZXQuY28uaW4iLCJVc2VTU0wiOnRydWUsIlRpbWVvdXQiOjV9" />

