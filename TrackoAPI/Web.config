	<connectionStrings>
		<clear />
		<add name="TenantHost" connectionString="Data Source=.;Database=AfricaAPITenant;Integrated Security=False;User ID=sa;Password=Gofleet@Iwlt#;Connect Timeout=150;Encrypt=False;TrustServerCertificate=False;ApplicationIntent=ReadWrite;MultiSubnetFailover=False;" providerName="System.Data.SqlClient"/>
